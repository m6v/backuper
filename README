# Программа для резервирования/восстановления СЗИ НСД
# NB! Диск с резервными копиями должен иметь метку BACKUP, диску с системным разделом лучше присвоить метку SYSTEM
# USAGE:
mkdir /mnt/backup
mount $(blkid -L BACKUP) /mnt/backup
cd /mnt/backup
./backuper

# Если для восстановления системы используется новый диск необходимо с помощью программы parted выполнить его разметку
# см.: wiki.archlinux.org/title/parted
list-devices disk # вывести список дисков (не разделов)
parted /dev/sda --script mklabel msdos # удалить все разделы
parted /dev/sda mkpart primary ext4 1MiB 100% # создать корневой раздел на весь диск
parted /dev/sda set 1 boot on # установить флаг загрузочного раздела

# Если ОС использовала раздел подкачки, то после восстановления на новый диск и загрузке с него будет возникать предупреждение "Gave up waiting for suspend/resume device" и некоторое время ожидать дальнейшей загрузки
# Отключение swap проблему не решило или не до конца отключен? Удалялся файл /etc/initramfs-tools/conf.d/resume, комментировалась соответствующая сторока в /etc/fstab, выполнялись команды update-initramfs -u и swapoff -a

